function fmt(n) {
  return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
}
function fmtDec(n) {
  return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

// --- KPIs ---
function renderKPIs() {
  const totalRevenue = filteredData.reduce((s, r) => s + r.amount, 0);
  const totalJobs = filteredData.length;
  const avgTicket = totalJobs > 0 ? totalRevenue / totalJobs : 0;
  const newCount = filteredData.filter(r => r.customerType.toLowerCase().includes('new')).length;
  const retCount = totalJobs - newCount;
  const newPct = totalJobs > 0 ? Math.round(newCount / totalJobs * 100) : 0;
  const retPct = 100 - newPct;

  document.getElementById('kpiRevenue').textContent = fmt(totalRevenue);
  document.getElementById('kpiRevenueSub').textContent = totalJobs > 0 ? 'from ' + totalJobs + ' jobs' : '';
  document.getElementById('kpiJobs').textContent = totalJobs.toLocaleString();
  document.getElementById('kpiJobsSub').textContent = filteredData.reduce((s,r)=>s+r.tips,0) > 0 ? fmt(filteredData.reduce((s,r)=>s+r.tips,0)) + ' in tips' : '';
  document.getElementById('kpiAvgTicket').textContent = fmt(Math.round(avgTicket));
  document.getElementById('kpiAvgTicketSub').textContent = avgTicket > 0 ? 'per completed job' : '';
  document.getElementById('kpiCustomers').textContent = newPct + '% / ' + retPct + '%';
  document.getElementById('kpiCustomersSub').textContent = newCount + ' new, ' + retCount + ' returning';
}

// --- Revenue Over Time (vertical bars) ---
function renderRevenueOverTime() {
  const container = document.getElementById('revenueOverTime');
  container.innerHTML = '';
  if (filteredData.length === 0) { container.innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:40px 0;">No data</p>'; return; }

  // Decide granularity
  const dates = filteredData.map(r => r.date).sort((a,b) => a-b);
  const spanDays = (dates[dates.length-1] - dates[0]) / (1000*60*60*24);
  const useWeekly = spanDays <= 90;

  const buckets = {};
  filteredData.forEach(r => {
    let key;
    if (useWeekly) {
      const d = new Date(r.date);
      const dayOfWeek = d.getDay();
      const weekStart = new Date(d);
      weekStart.setDate(d.getDate() - dayOfWeek);
      key = weekStart.toISOString().slice(0,10);
    } else {
      key = r.date.getFullYear() + '-' + String(r.date.getMonth()+1).padStart(2,'0');
    }
    buckets[key] = (buckets[key] || 0) + r.amount;
  });

  const sortedKeys = Object.keys(buckets).sort();
  const maxVal = Math.max(...Object.values(buckets), 1);

  sortedKeys.forEach(key => {
    const pct = (buckets[key] / maxVal * 100);
    const isTop = buckets[key] === maxVal;
    const label = useWeekly ? formatWeekLabel(key) : formatMonthLabel(key);

    const group = document.createElement('div');
    group.className = 'vbar-group';
    group.innerHTML = `
      <div class="vbar-amount">${fmt(buckets[key])}</div>
      <div class="vbar${isTop ? ' top-performer' : ''}" style="height:${Math.max(pct, 2)}%"></div>
      <div class="vbar-label">${label}</div>
    `;
    container.appendChild(group);
  });
}

function formatWeekLabel(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  return (d.getMonth()+1) + '/' + d.getDate();
}
function formatMonthLabel(key) {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const parts = key.split('-');
  return months[parseInt(parts[1])-1] + (parts[0] !== new Date().getFullYear().toString() ? " '" + parts[0].slice(2) : '');
}

