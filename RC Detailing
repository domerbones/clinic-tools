// --- Employee Table ---
function renderEmployeeTable() {
  const tbody = document.getElementById('employeeTableBody');
  tbody.innerHTML = '';
  if (filteredData.length === 0) return;

  const emps = {};
  filteredData.forEach(r => {
    if (!emps[r.employee]) emps[r.employee] = { jobs: 0, revenue: 0, tips: 0, commission: 0, hours: 0 };
    emps[r.employee].jobs++;
    emps[r.employee].revenue += r.amount;
    emps[r.employee].tips += r.tips;
    emps[r.employee].commission += r.commission;
    emps[r.employee].hours += r.hours;
  });

  let rows = Object.entries(emps).map(([name, d]) => ({
    name,
    jobs: d.jobs,
    revenue: d.revenue,
    tips: d.tips,
    commission: d.commission,
    avgHours: d.jobs > 0 ? d.hours / d.jobs : 0
  }));

  if (tableSortCol >= 0) {
    const keys = ['name', 'jobs', 'revenue', 'tips', 'commission', 'avgHours'];
    const key = keys[tableSortCol];
    rows.sort((a, b) => {
      let cmp = key === 'name' ? a.name.localeCompare(b.name) : a[key] - b[key];
      return tableSortAsc ? cmp : -cmp;
    });
  } else {
    rows.sort((a, b) => b.revenue - a.revenue);
  }

  let totals = { jobs: 0, revenue: 0, tips: 0, commission: 0, hours: 0, count: 0 };
  rows.forEach(r => {
    totals.jobs += r.jobs;
    totals.revenue += r.revenue;
    totals.tips += r.tips;
    totals.commission += r.commission;
    totals.hours += r.avgHours;
    totals.count++;

    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${r.name}</td>
      <td>${r.jobs}</td>
      <td>${fmt(r.revenue)}</td>
      <td>${fmt(r.tips)}</td>
      <td>${fmt(r.commission)}</td>
      <td>${r.avgHours.toFixed(1)} hrs</td>
    `;
    tbody.appendChild(tr);
  });

  const avgHoursTotal = totals.count > 0 ? (totals.hours / totals.count) : 0;
  const trTot = document.createElement('tr');
  trTot.className = 'totals-row';
  trTot.innerHTML = `
    <td>TOTALS</td>
    <td>${totals.jobs}</td>
    <td>${fmt(totals.revenue)}</td>
    <td>${fmt(totals.tips)}</td>
    <td>${fmt(totals.commission)}</td>
    <td>${avgHoursTotal.toFixed(1)} hrs avg</td>
  `;
  tbody.appendChild(trTot);
}

function sortTable(colIdx) {
  if (tableSortCol === colIdx) {
    tableSortAsc = !tableSortAsc;
  } else {
    tableSortCol = colIdx;
    tableSortAsc = colIdx === 0; // name asc, numbers desc by default
  }
  renderEmployeeTable();
}

