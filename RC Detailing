          <span>Returning: ${retC} jobs (${retPct}%)</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background:var(--primary-light)"></span>
          <span>New: ${newC} jobs (${newPct}%)</span>
        </div>
        <div class="legend-item" style="margin-top:8px; color: var(--text-muted); font-size:0.8rem;">
          ${total} total customers in period
