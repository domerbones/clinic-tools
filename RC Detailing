            stroke-dasharray="${newDash} ${circumference}" stroke-dashoffset="${-retDash}" stroke-linecap="round"/>
        </svg>
        <div class="retention-ring-label">
          <span class="retention-ring-pct" style="color:var(--accent)">${retPct}%</span>
          <span class="retention-ring-name">Returning</span>
