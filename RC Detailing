<!DOCTYPE html>
<html lang="en">
<head>
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<meta name="theme-color" content="#6B21A8">

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RC Detailing - Analytics Dashboard</title>
<!--
  RC DETAILING ANALYTICS DASHBOARD
  ================================
  Upload CSV exports from Urable (or any CRM) with these columns:
  Date,Customer,Service,Amount,Employee,Tips,Commission,Hours,Status,Payment,Vehicle,CustomerType

  Example rows:
  2026-08-01,John Smith,Full Detail,250,Chase,25,50,3.5,Completed,Card,SUV,New
  2026-08-01,Jane Doe,Ceramic Coating,800,Mike,40,160,6,Completed,Card,Sedan,Returning
  2026-08-02,Bob Wilson,Express Wash,45,Chase,5,9,0.75,Completed,Cash,Truck,New
-->
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --primary: #6B21A8;
    --primary-light: #7c3aed;
    --primary-dark: #581c87;
    --secondary: #1a1a1a;
    --accent: #D4A843;
    --accent-light: #e2c06e;
    --bg: #0d0d0d;
    --text: #ffffff;
    --text-muted: #a0a0a0;
    --card-bg: #1a1a1a;
    --card-border: rgba(107, 33, 168, 0.3);
    --card-border-gold: rgba(212, 168, 67, 0.3);
    --success: #22c55e;
    --danger: #ef4444;
    --radius: 12px;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    min-height: 100vh;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
  }

  /* ===== HEADER ===== */
  .header {
    text-align: center;
    padding: 40px 20px 30px;
    border-bottom: 2px solid var(--accent);
    margin-bottom: 30px;
    position: relative;
  }
  .header h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: 6px;
    background: linear-gradient(135deg, var(--accent), var(--accent-light), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 4px;
  }
  .header .subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 300;
  }
  .header .tagline {
    font-size: 0.8rem;
    color: var(--primary-light);
    margin-top: 4px;
    letter-spacing: 2px;
  }

  /* ===== UPLOAD AREA ===== */
  .upload-section {
    margin-bottom: 30px;
  }
  .upload-area {
    border: 2px dashed var(--primary);
    border-radius: var(--radius);
    padding: 30px;
    text-align: center;
    background: rgba(107, 33, 168, 0.05);
    transition: all 0.3s;
    cursor: pointer;
    position: relative;
  }
  .upload-area:hover, .upload-area.dragover {
    border-color: var(--accent);
    background: rgba(212, 168, 67, 0.05);
  }
  .upload-area .upload-icon {
    font-size: 2.5rem;
    margin-bottom: 10px;
    display: block;
  }
  .upload-area p { color: var(--text-muted); margin: 5px 0; }
  .upload-area .browse-link {
    color: var(--accent);
    text-decoration: underline;
    cursor: pointer;
    font-weight: 600;
  }
  .upload-area input[type="file"] {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    opacity: 0;
    cursor: pointer;
  }
  .upload-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .btn {
    padding: 10px 24px;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-primary {
    background: var(--primary);
    color: white;
  }
  .btn-primary:hover { background: var(--primary-light); }
  .btn-accent {
    background: var(--accent);
    color: #000;
  }
  .btn-accent:hover { background: var(--accent-light); }
  .btn-outline {
    background: transparent;
    color: var(--text-muted);
    border: 1px solid rgba(255,255,255,0.2);
  }
  .btn-outline:hover { border-color: var(--accent); color: var(--accent); }
  .btn-sm { padding: 6px 14px; font-size: 0.8rem; }

  .last-updated {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 12px;
  }

  /* ===== DASHBOARD (hidden until data loaded) ===== */
  .dashboard { display: none; }
  .dashboard.active { display: block; }

  /* ===== DATE RANGE ===== */
  .date-range-bar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 30px;
    padding: 16px;
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 1px solid var(--card-border);
  }
  .date-btn {
    padding: 8px 18px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .date-btn:hover { border-color: var(--primary); color: var(--text); }
  .date-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  /* ===== GRID ===== */
  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 30px;
  }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 30px;
  }
  .grid-1 {
    margin-bottom: 30px;
  }

  /* ===== CARDS ===== */
  .card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 24px;
    border: 1px solid var(--card-border);
    transition: border-color 0.2s;
  }
  .card:hover { border-color: var(--primary-light); }
  .card-gold { border-color: var(--card-border-gold); }
  .card-gold:hover { border-color: var(--accent); }

  /* ===== KPI CARDS ===== */
  .kpi-card .kpi-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 500;
    margin-bottom: 8px;
  }
  .kpi-card .kpi-value {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
  }
  .kpi-card .kpi-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 6px;
  }
  .kpi-value.gold { color: var(--accent); }

  /* ===== CHART CARDS ===== */
  .chart-card .chart-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .chart-title-icon {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }

  /* ===== BAR CHARTS ===== */
  .bar-chart {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bar-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bar-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    min-width: 80px;
    text-align: right;
    flex-shrink: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bar-track {
    flex: 1;
    height: 28px;
    background: rgba(255,255,255,0.05);
    border-radius: 6px;
    overflow: hidden;
    position: relative;
  }
  .bar-fill {
    height: 100%;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--primary), var(--primary-light));
    transition: width 0.6s ease;
    min-width: 2px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 8px;
  }
  .bar-fill.top-performer {
    background: linear-gradient(90deg, var(--accent), var(--accent-light));
  }
  .bar-value {
    font-size: 0.75rem;
    font-weight: 600;
    color: white;
    white-space: nowrap;
  }
  .bar-value-outside {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-left: 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ===== VERTICAL BAR CHART ===== */
  .vbar-chart {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 200px;
    padding-top: 20px;
    position: relative;
  }
  .vbar-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
    min-width: 0;
  }
  .vbar {
    width: 80%;
    max-width: 60px;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(180deg, var(--primary-light), var(--primary));
    transition: height 0.6s ease;
    min-height: 2px;
    position: relative;
  }
  .vbar.top-performer {
    background: linear-gradient(180deg, var(--accent-light), var(--accent));
  }
  .vbar-amount {
    font-size: 0.65rem;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: 4px;
    white-space: nowrap;
  }
  .vbar-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* ===== TABLE ===== */
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th, td {
    text-align: left;
    padding: 12px 16px;
    font-size: 0.85rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  th {
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.75rem;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  th:hover { color: var(--accent); }
  th .sort-arrow { margin-left: 4px; font-size: 0.65rem; }
  tr:hover td { background: rgba(107, 33, 168, 0.08); }
  tr.totals-row td {
    border-top: 2px solid var(--accent);
    font-weight: 700;
    color: var(--accent);
    background: rgba(212, 168, 67, 0.05);
  }

  /* ===== GOAL TRACKER ===== */
  .goal-section {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .goal-input-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .goal-input-group label {
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .goal-input {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    padding: 8px 14px;
    color: var(--text);
    font-size: 1rem;
    width: 140px;
    font-family: inherit;
  }
  .goal-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .goal-progress-wrap {
    flex: 1;
    min-width: 200px;
  }
  .goal-progress-bar {
    height: 30px;
    background: rgba(255,255,255,0.05);
    border-radius: 15px;
    overflow: hidden;
    position: relative;
  }
  .goal-progress-fill {
    height: 100%;
    border-radius: 15px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    transition: width 0.6s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .goal-progress-text {
    font-size: 0.8rem;
    font-weight: 700;
    color: white;
    white-space: nowrap;
  }
  .goal-info {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 8px;
    display: flex;
    justify-content: space-between;
  }

  /* ===== GROWTH CARD ===== */
  .growth-indicator {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }
  .growth-arrow {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .growth-arrow.up { color: var(--success); }
  .growth-arrow.down { color: var(--danger); }
  .growth-pct {
    font-size: 2rem;
    font-weight: 700;
  }
  .growth-pct.up { color: var(--success); }
  .growth-pct.down { color: var(--danger); }
  .growth-detail {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* ===== RETENTION VISUAL ===== */
  .retention-visual {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
  }
  .retention-ring {
    width: 140px;
    height: 140px;
    position: relative;
  }
  .retention-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .retention-ring-label {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }
  .retention-ring-pct {
    font-size: 1.5rem;
    font-weight: 700;
    display: block;
  }
  .retention-ring-name {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .retention-legend {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }
  .legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  /* ===== TOP ACTION BAR ===== */
  .action-bar {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  /* ===== PRINT ===== */
  @media print {
    body { background: white; color: black; }
    .upload-section, .action-bar, .date-range-bar, .goal-input-group, .btn { display: none !important; }
    .dashboard { display: block !important; }
    .card { border: 1px solid #ccc; page-break-inside: avoid; }
    .header { border-bottom-color: #333; }
    .header h1 { -webkit-text-fill-color: #333; color: #333; }
    .kpi-card .kpi-value, .kpi-value.gold { color: #333 !important; }
    .bar-fill { background: #555 !important; }
    .bar-fill.top-performer { background: #888 !important; }
    .vbar { background: #555 !important; }
    .vbar.top-performer { background: #888 !important; }
    .growth-pct.up, .growth-arrow.up { color: #22883e !important; }
    .growth-pct.down, .growth-arrow.down { color: #c0392b !important; }
    tr.totals-row td { border-top-color: #333; color: #333; }
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .grid-4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .container { padding: 12px; }
    .header h1 { font-size: 2rem; letter-spacing: 3px; }
    .header .subtitle { font-size: 0.9rem; }
    .grid-4 { grid-template-columns: 1fr 1fr; }
    .grid-2 { grid-template-columns: 1fr; }
    .kpi-card .kpi-value { font-size: 1.6rem; }
    .bar-label { min-width: 60px; font-size: 0.7rem; }
    .goal-section { flex-direction: column; align-items: stretch; }
    .date-range-bar { gap: 6px; }
    .date-btn { padding: 6px 12px; font-size: 0.75rem; }
    th, td { padding: 8px 10px; font-size: 0.75rem; }
    .action-bar { justify-content: center; }
  }
  @media (max-width: 480px) {
    .grid-4 { grid-template-columns: 1fr; }
    .header h1 { font-size: 1.6rem; letter-spacing: 2px; }
    .upload-area { padding: 20px; }
  }

  /* ===== TOAST ===== */
  .toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: var(--primary);
    color: white;
    padding: 12px 28px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 8px 30px rgba(107, 33, 168, 0.4);
    z-index: 1000;
    transition: transform 0.3s ease;
    pointer-events: none;
  }
  .toast.show {
    transform: translateX(-50%) translateY(0);
  }
</style>
</head>
<body>

<div class="container">

  <!-- HEADER -->
  <div class="header">
    <h1>RC DETAILING</h1>
    <div class="subtitle">Analytics Dashboard</div>
    <div class="tagline">Revive Your Ride, Right Outside</div>
  </div>

  <!-- UPLOAD SECTION -->
  <div class="upload-section">
    <div class="upload-area" id="uploadArea">
      <span class="upload-icon">&#128203;</span>
      <p><strong>Drop your Urable CSV export here</strong></p>
      <p>or <span class="browse-link">browse to select a file</span></p>
      <p style="font-size:0.75rem; color: rgba(255,255,255,0.3); margin-top:8px;">
        Accepts .csv files with columns: Date, Customer, Service, Amount, Employee, Tips, Commission, Hours, Status, Payment, Vehicle, CustomerType
      </p>
      <input type="file" id="csvFileInput" accept=".csv">
    </div>
    <div class="upload-actions">
      <button class="btn btn-accent" onclick="loadDemoData()">Load Demo Data</button>
      <button class="btn btn-outline btn-sm" onclick="clearData()">Clear Data</button>
    </div>
    <div class="last-updated" id="lastUpdated"></div>
  </div>

  <!-- DASHBOARD -->
  <div class="dashboard" id="dashboard">

    <!-- ACTION BAR -->
    <div class="action-bar">
      <button class="btn btn-outline btn-sm" onclick="window.print()">&#128424; Print</button>
      <button class="btn btn-outline btn-sm" onclick="copySummary()">&#128203; Copy Summary</button>
    </div>

    <!-- DATE RANGE -->
    <div class="date-range-bar" id="dateRangeBar">
      <button class="date-btn" data-range="thisWeek">This Week</button>
      <button class="date-btn" data-range="lastWeek">Last Week</button>
      <button class="date-btn" data-range="thisMonth">This Month</button>
      <button class="date-btn" data-range="lastMonth">Last Month</button>
      <button class="date-btn" data-range="last90">Last 90 Days</button>
      <button class="date-btn" data-range="ytd">Year to Date</button>
      <button class="date-btn active" data-range="all">All Time</button>
    </div>

    <!-- KPI ROW -->
    <div class="grid-4" id="kpiRow">
      <div class="card kpi-card">
        <div class="kpi-label">Total Revenue</div>
        <div class="kpi-value gold" id="kpiRevenue">$0</div>
        <div class="kpi-sub" id="kpiRevenueSub"></div>
      </div>
      <div class="card kpi-card card-gold">
        <div class="kpi-label">Jobs Completed</div>
        <div class="kpi-value" id="kpiJobs">0</div>
        <div class="kpi-sub" id="kpiJobsSub"></div>
      </div>
      <div class="card kpi-card">
        <div class="kpi-label">Average Ticket</div>
        <div class="kpi-value gold" id="kpiAvgTicket">$0</div>
        <div class="kpi-sub" id="kpiAvgTicketSub"></div>
      </div>
      <div class="card kpi-card card-gold">
        <div class="kpi-label">New vs Returning</div>
        <div class="kpi-value" id="kpiCustomers">--</div>
        <div class="kpi-sub" id="kpiCustomersSub"></div>
      </div>
    </div>

    <!-- ROW 2: Revenue Over Time + Revenue by Service -->
    <div class="grid-2">
      <div class="card chart-card">
        <div class="chart-title"><span class="chart-title-icon"></span>Revenue Over Time</div>
        <div id="revenueOverTime" class="vbar-chart"></div>
      </div>
      <div class="card chart-card">
        <div class="chart-title"><span class="chart-title-icon"></span>Revenue by Service Type</div>
        <div id="revenueByService" class="bar-chart"></div>
      </div>
    </div>

    <!-- ROW 3: Jobs by Employee + Revenue by Employee -->
    <div class="grid-2">
      <div class="card chart-card">
        <div class="chart-title"><span class="chart-title-icon"></span>Jobs by Employee</div>
        <div id="jobsByEmployee" class="bar-chart"></div>
      </div>
      <div class="card chart-card">
        <div class="chart-title"><span class="chart-title-icon"></span>Revenue by Employee</div>
        <div id="revenueByEmployee" class="bar-chart"></div>
      </div>
    </div>

    <!-- ROW 4: Employee Details Table -->
    <div class="grid-1">
      <div class="card">
        <div class="chart-title"><span class="chart-title-icon"></span>Employee Performance Details</div>
        <div class="table-wrap">
          <table id="employeeTable">
            <thead>
              <tr>
                <th onclick="sortTable(0)">Employee <span class="sort-arrow"></span></th>
                <th onclick="sortTable(1)">Jobs <span class="sort-arrow"></span></th>
                <th onclick="sortTable(2)">Revenue <span class="sort-arrow"></span></th>
                <th onclick="sortTable(3)">Tips <span class="sort-arrow"></span></th>
                <th onclick="sortTable(4)">Commission <span class="sort-arrow"></span></th>
                <th onclick="sortTable(5)">Avg Hrs/Job <span class="sort-arrow"></span></th>
              </tr>
            </thead>
            <tbody id="employeeTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ROW 5: Busiest Days + Customer Retention -->
    <div class="grid-2">
      <div class="card chart-card">
        <div class="chart-title"><span class="chart-title-icon"></span>Busiest Days of the Week</div>
