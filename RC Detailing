<script>
(function() {
  "use strict";

  var SECTIONS = [
    "Front Bumper",
    "Hood",
    "Roof",
    "Trunk / Rear",
    "Driver Side (full)",
    "Passenger Side (full)",
    "Driver Front Fender",
    "Passenger Front Fender",
    "Driver Rear Quarter Panel",
    "Passenger Rear Quarter Panel",
    "Wheels - Driver Front",
    "Wheels - Driver Rear",
    "Wheels - Passenger Front",
    "Wheels - Passenger Rear",
    "Interior - Dash & Console",
    "Interior - Seats",
    "Interior - Carpet / Floor",
    "Headliner",
    "Trunk Interior"
  ];

  var MAX_IMAGE_WIDTH = 1200;
  var sectionData = {};

  // Initialize section data
  function initSectionData() {
    for (var i = 0; i < SECTIONS.length; i++) {
      sectionData[i] = {
        beforePhoto: null,
        afterPhoto: null,
        damageNotes: "",
        qualityCheck: false
      };
    }
  }

  // Set default date
  function setDefaultDate() {
    var today = new Date();
    var yyyy = today.getFullYear();
    var mm = String(today.getMonth() + 1).padStart(2, "0");
    var dd = String(today.getDate()).padStart(2, "0");
    document.getElementById("jobDate").value = yyyy + "-" + mm + "-" + dd;
  }

  // Get section status
  function getSectionStatus(idx) {
    var d = sectionData[idx];
    if (!d.beforePhoto) return "not-started";
    if (d.beforePhoto && d.afterPhoto && d.qualityCheck) return "complete";
    return "progress";
  }

  // Count complete sections
  function countComplete() {
    var count = 0;
    for (var i = 0; i < SECTIONS.length; i++) {
      if (getSectionStatus(i) === "complete") count++;
    }
    return count;
  }

  // Count in-progress sections
  function countInProgress() {
    var count = 0;
    for (var i = 0; i < SECTIONS.length; i++) {
      if (getSectionStatus(i) === "progress") count++;
    }
    return count;
  }

  // Update progress bar
  function updateProgress() {
    var complete = countComplete();
    var inProgress = countInProgress();
    var pct = Math.round((complete / SECTIONS.length) * 100);
    var textEl = document.getElementById("progressText");
    var fillEl = document.getElementById("progressFill");

    textEl.textContent = complete + " of " + SECTIONS.length + " sections complete";
    fillEl.style.width = pct + "%";

    if (complete === SECTIONS.length) {
      fillEl.style.background = "#22c55e";
    } else if (complete > 0 || inProgress > 0) {
      fillEl.style.background = "#D4A843";
    } else {
      fillEl.style.background = "#D4A843";
    }
  }

  // Update section visual status
  function updateSectionCard(idx) {
    var card = document.getElementById("section-card-" + idx);
    var dot = document.getElementById("status-dot-" + idx);
    var status = getSectionStatus(idx);

    card.classList.remove("status-progress", "status-complete");
    dot.classList.remove("progress", "complete");

    if (status === "progress") {
      card.classList.add("status-progress");
      dot.classList.add("progress");
    } else if (status === "complete") {
      card.classList.add("status-complete");
      dot.classList.add("complete");
    }

    // Update compare button state
    var compareBtn = document.getElementById("compare-btn-" + idx);
    if (compareBtn) {
      compareBtn.disabled = !(sectionData[idx].beforePhoto && sectionData[idx].afterPhoto);
    }

    updateProgress();
  }

  // Resize image using canvas
  function resizeImage(file, callback) {
    var reader = new FileReader();
    reader.onload = function(e) {
      var img = new Image();
      img.onload = function() {
        var w = img.width;
        var h = img.height;

        if (w > MAX_IMAGE_WIDTH) {
          h = Math.round(h * (MAX_IMAGE_WIDTH / w));
          w = MAX_IMAGE_WIDTH;
        }

        var canvas = document.createElement("canvas");
        canvas.width = w;
        canvas.height = h;
        var ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0, w, h);

        var dataUrl = canvas.toDataURL("image/jpeg", 0.8);
        callback(dataUrl);
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  // Handle photo capture
  function handlePhoto(idx, type) {
    var inputId = "file-" + type + "-" + idx;
    var input = document.getElementById(inputId);
    if (!input) return;

    input.addEventListener("change", function() {
      if (this.files && this.files[0]) {
        var self = this;
        resizeImage(this.files[0], function(dataUrl) {
          sectionData[idx][type + "Photo"] = dataUrl;

          var thumb = document.getElementById("thumb-" + type + "-" + idx);
          if (thumb) {
            thumb.src = dataUrl;
            thumb.classList.add("visible");
          }

          var btn = document.getElementById("btn-" + type + "-" + idx);
          if (btn) {
            btn.classList.add("has-photo");
            btn.textContent = (type === "before") ? "Retake Before" : "Retake After";
          }

          updateSectionCard(idx);
          self.value = "";
        });
      }
    });

    input.click();
  }

  // Build sections
  function buildSections() {
    var container = document.getElementById("sectionsContainer");
    var html = "";

    for (var i = 0; i < SECTIONS.length; i++) {
      html += '<div class="section-card" id="section-card-' + i + '">';
      html += '  <div class="section-header" onclick="window._toggleSection(' + i + ')">';
      html += '    <div class="section-header-left">';
      html += '      <div class="status-dot" id="status-dot-' + i + '"></div>';
      html += '      <span class="section-name">' + (i + 1) + '. ' + SECTIONS[i] + '</span>';
      html += '    </div>';
      html += '    <span class="section-chevron">&#9660;</span>';
      html += '  </div>';
      html += '  <div class="section-body" id="section-body-' + i + '">';
      html += '    <div class="section-body-inner">';

      // Before Photo
      html += '      <div class="photo-group">';
      html += '        <div class="photo-label">Before Photo</div>';
      html += '        <input type="file" accept="image/*" capture="environment" class="file-input-hidden" id="file-before-' + i + '">';
      html += '        <button type="button" class="photo-btn" id="btn-before-' + i + '" onclick="window._takePhoto(' + i + ', \'before\')">Take Before Photo</button>';
      html += '        <img class="photo-thumb" id="thumb-before-' + i + '" src="" alt="Before" onclick="window._previewImage(this.src)">';
      html += '      </div>';

      // Damage Notes
      html += '      <div class="photo-group">';
      html += '        <div class="damage-notes-label">Damage Notes</div>';
      html += '        <textarea class="damage-notes" id="notes-' + i + '" placeholder="Document any pre-existing damage..." onchange="window._updateNotes(' + i + ')"></textarea>';
      html += '      </div>';

      // After Photo
      html += '      <div class="photo-group">';
      html += '        <div class="photo-label">After Photo</div>';
      html += '        <input type="file" accept="image/*" capture="environment" class="file-input-hidden" id="file-after-' + i + '">';
      html += '        <button type="button" class="photo-btn" id="btn-after-' + i + '" onclick="window._takePhoto(' + i + ', \'after\')">Take After Photo</button>';
      html += '        <img class="photo-thumb" id="thumb-after-' + i + '" src="" alt="After" onclick="window._previewImage(this.src)">';
      html += '      </div>';

      // Compare Button
      html += '      <button type="button" class="compare-btn" id="compare-btn-' + i + '" onclick="window._openCompare(' + i + ')" disabled>Compare Before &amp; After</button>';

      // Quality Checkbox
      html += '      <label class="quality-check">';
      html += '        <input type="checkbox" id="quality-' + i + '" onchange="window._updateQuality(' + i + ')">';
      html += '        <span class="quality-check-label">Section meets quality standards</span>';
      html += '      </label>';

      html += '    </div>';
      html += '  </div>';
      html += '</div>';
    }

    container.innerHTML = html;
  }

  // Toggle section
  function toggleSection(idx) {
    var body = document.getElementById("section-body-" + idx);
    var card = document.getElementById("section-card-" + idx);

    if (card.classList.contains("open")) {
      body.style.maxHeight = "0";
      card.classList.remove("open");
    } else {
      body.style.maxHeight = body.scrollHeight + 200 + "px";
      card.classList.add("open");
    }
  }

  // Update notes
  function updateNotes(idx) {
    var textarea = document.getElementById("notes-" + idx);
    if (textarea) {
      sectionData[idx].damageNotes = textarea.value;
    }
  }

  // Update quality
  function updateQuality(idx) {
    var cb = document.getElementById("quality-" + idx);
    if (cb) {
      sectionData[idx].qualityCheck = cb.checked;
      updateSectionCard(idx);
    }
  }

  // Open compare modal
  function openCompare(idx) {
    var d = sectionData[idx];
    if (!d.beforePhoto || !d.afterPhoto) return;

    var modal = document.getElementById("compareModal");
    var title = document.getElementById("compareTitle");
    var images = document.getElementById("compareImages");

    title.textContent = SECTIONS[idx] + " - Before & After";

    var html = '';
    html += '<div class="compare-col">';
    html += '  <div class="compare-col-label">Before</div>';
    html += '  <img src="' + d.beforePhoto + '" alt="Before">';
    html += '</div>';
    html += '<div class="compare-col">';
    html += '  <div class="compare-col-label">After</div>';
    html += '  <img src="' + d.afterPhoto + '" alt="After">';
    html += '</div>';

    images.innerHTML = html;
    modal.classList.add("active");
    document.body.style.overflow = "hidden";
  }

  // Close compare modal
  window.closeCompareModal = function() {
    var modal = document.getElementById("compareModal");
    modal.classList.remove("active");
    document.body.style.overflow = "";
  };

  // Preview single image
  function previewImage(src) {
    if (!src) return;
    var overlay = document.getElementById("imagePreview");
    var img = document.getElementById("imagePreviewImg");
    img.src = src;
    overlay.classList.add("active");
    document.body.style.overflow = "hidden";
  }

  // Close image preview
  window.closeImagePreview = function() {
    var overlay = document.getElementById("imagePreview");
    overlay.classList.remove("active");
    document.body.style.overflow = "";
  };

  // Get job info
  function getJobInfo() {
    return {
      customerName: document.getElementById("customerName").value || "N/A",
      jobDate: document.getElementById("jobDate").value || "N/A",
      employeeName: document.getElementById("employeeName").value || "N/A",
      vehicleYear: document.getElementById("vehicleYear").value || "",
      vehicleMake: document.getElementById("vehicleMake").value || "",
      vehicleModel: document.getElementById("vehicleModel").value || "",
      vehicleColor: document.getElementById("vehicleColor").value || ""
    };
  }

  // Format date for display
  function formatDate(dateStr) {
    if (!dateStr || dateStr === "N/A") return "N/A";
    var parts = dateStr.split("-");
    if (parts.length !== 3) return dateStr;
    return parts[1] + "/" + parts[2] + "/" + parts[0];
  }

  // Generate report
  window.generateReport = function() {
    var job = getJobInfo();
    var vehicle = [job.vehicleYear, job.vehicleMake, job.vehicleModel].filter(function(v) { return v; }).join(" ");
    var now = new Date();
    var timestamp = now.toLocaleString();

    var html = '';
    html += '<div class="report-header">';
    html += '  <h1>RC Detailing</h1>';
    html += '  <h2>Vehicle Inspection Report</h2>';
    html += '</div>';
    html += '<div class="report-body">';

    // Job info summary
    html += '<div class="report-job-info">';
    html += '  <div class="report-job-row"><span class="report-job-label">Customer</span><span class="report-job-value">' + job.customerName + '</span></div>';
    html += '  <div class="report-job-row"><span class="report-job-label">Date</span><span class="report-job-value">' + formatDate(job.jobDate) + '</span></div>';
    html += '  <div class="report-job-row"><span class="report-job-label">Employee</span><span class="report-job-value">' + job.employeeName + '</span></div>';
    html += '  <div class="report-job-row"><span class="report-job-label">Vehicle</span><span class="report-job-value">' + (vehicle || "N/A") + '</span></div>';
    html += '  <div class="report-job-row"><span class="report-job-label">Color</span><span class="report-job-value">' + (job.vehicleColor || "N/A") + '</span></div>';
    html += '</div>';

    // Sections
    for (var i = 0; i < SECTIONS.length; i++) {
      var d = sectionData[i];
      var status = getSectionStatus(i);
      var statusLabel = "Not Started";
      var statusClass = "not-started";

      if (status === "progress") {
        statusLabel = "In Progress";
        statusClass = "progress";
      } else if (status === "complete") {
        statusLabel = "Complete";
        statusClass = "complete";
      }

      html += '<div class="report-section">';
      html += '  <div class="report-section-title">';
      html += '    ' + (i + 1) + '. ' + SECTIONS[i];
      html += '    <span class="report-status-badge ' + statusClass + '">' + statusLabel + '</span>';
      html += '  </div>';

      html += '  <div class="report-photos">';
      html += '    <div class="report-photo-col">';
      html += '      <div class="report-photo-label">Before</div>';
      if (d.beforePhoto) {
        html += '    <img src="' + d.beforePhoto + '" alt="Before">';
      } else {
        html += '    <div class="report-no-photo">No photo</div>';
      }
      html += '    </div>';
      html += '    <div class="report-photo-col">';
      html += '      <div class="report-photo-label">After</div>';
      if (d.afterPhoto) {
        html += '    <img src="' + d.afterPhoto + '" alt="After">';
      } else {
        html += '    <div class="report-no-photo">No photo</div>';
      }
      html += '    </div>';
      html += '  </div>';

      if (d.damageNotes) {
        html += '  <div class="report-damage-notes"><strong>Damage Notes:</strong> ' + escapeHtml(d.damageNotes) + '</div>';
      }

      if (d.qualityCheck) {
        html += '  <div class="report-quality pass">Quality Standards: PASS</div>';
      } else {
        html += '  <div class="report-quality fail">Quality Standards: NOT VERIFIED</div>';
      }

      html += '</div>';
    }

    // Footer
    html += '<div class="report-footer">';
    html += '  <div class="report-timestamp">Report generated: ' + timestamp + '</div>';
    html += '  <div style="margin-top:30px;">';
    html += '    <div class="report-sig-line">Employee Signature</div>';
    html += '  </div>';
    html += '</div>';

    html += '<div style="text-align:center; padding: 16px;">';
    html += '  <button type="button" class="close-report-btn" onclick="window._closeReport()">Close Report</button>';
    html += '</div>';

    html += '</div>';

    var reportView = document.getElementById("reportView");
    reportView.innerHTML = html;
    reportView.classList.add("active");

    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  // Close report
  window._closeReport = function() {
    var reportView = document.getElementById("reportView");
    reportView.classList.remove("active");
    reportView.innerHTML = "";
  };

  // Export PDF
  window.exportPDF = function() {
    window.generateReport();
    setTimeout(function() {
      window.print();
    }, 300);
  };

  // Email report
  window.emailReport = function() {
    var job = getJobInfo();
    var vehicle = [job.vehicleYear, job.vehicleMake, job.vehicleModel].filter(function(v) { return v; }).join(" ");
    var subject = "RC Detailing Vehicle Inspection - " + job.customerName + " - " + vehicle + " - " + formatDate(job.jobDate);
    var body = "Vehicle inspection report attached. Please see the PDF for complete details including photos.";
    var mailto = "mailto:?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
    window.location.href = mailto;
  };

  // Clear inspection
  window.clearInspection = function() {
    if (!confirm("Are you sure? All photos and data will be lost.")) return;

    initSectionData();
    setDefaultDate();

    document.getElementById("customerName").value = "";
    document.getElementById("employeeName").value = "";
    document.getElementById("vehicleYear").value = "";
    document.getElementById("vehicleMake").value = "";
    document.getElementById("vehicleModel").value = "";
    document.getElementById("vehicleColor").value = "";

    for (var i = 0; i < SECTIONS.length; i++) {
      var beforeThumb = document.getElementById("thumb-before-" + i);
      var afterThumb = document.getElementById("thumb-after-" + i);
      var notes = document.getElementById("notes-" + i);
      var quality = document.getElementById("quality-" + i);
      var btnBefore = document.getElementById("btn-before-" + i);
      var btnAfter = document.getElementById("btn-after-" + i);

      if (beforeThumb) {
        beforeThumb.src = "";
        beforeThumb.classList.remove("visible");
      }
      if (afterThumb) {
        afterThumb.src = "";
        afterThumb.classList.remove("visible");
      }
      if (notes) notes.value = "";
      if (quality) quality.checked = false;
      if (btnBefore) {
        btnBefore.classList.remove("has-photo");
        btnBefore.textContent = "Take Before Photo";
      }
      if (btnAfter) {
        btnAfter.classList.remove("has-photo");
        btnAfter.textContent = "Take After Photo";
      }

      updateSectionCard(i);

      var card = document.getElementById("section-card-" + i);
      var body = document.getElementById("section-body-" + i);
      if (card) card.classList.remove("open");
      if (body) body.style.maxHeight = "0";
    }

    var reportView = document.getElementById("reportView");
    reportView.classList.remove("active");
    reportView.innerHTML = "";

    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  // Escape HTML
  function escapeHtml(str) {
    var div = document.createElement("div");
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  // Expose functions to global scope (no arrow functions)
  window._toggleSection = function(idx) { toggleSection(idx); };
  window._takePhoto = function(idx, type) { handlePhoto(idx, type); };
  window._updateNotes = function(idx) { updateNotes(idx); };
  window._updateQuality = function(idx) { updateQuality(idx); };
  window._openCompare = function(idx) { openCompare(idx); };
  window._previewImage = function(src) { previewImage(src); };

  // Initialize
  initSectionData();
  buildSections();
  setDefaultDate();
  updateProgress();

})();
</script>
<script>if("serviceWorker" in navigator){navigator.serviceWorker.register("sw.js").catch(function(){});}</script>
</body>
</html>
