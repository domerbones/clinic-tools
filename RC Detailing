}

// --- Monthly Growth ---
function renderMonthlyGrowth() {
  const container = document.getElementById('monthlyGrowth');
  container.innerHTML = '';

  // Use ALL data (not filtered) for month comparison
  const completedData = allData.filter(r => r.status !== 'cancelled' && r.status !== 'canceled');
  if (completedData.length === 0) { container.innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:40px 0;">No data</p>'; return; }

  const now = new Date();
  const thisMonthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const lastMonthStart = new Date(now.getFullYear(), now.getMonth() - 1, 1);
  const lastMonthEnd = new Date(now.getFullYear(), now.getMonth(), 0);

  const thisMonthRev = completedData.filter(r => r.date >= thisMonthStart).reduce((s,r)=>s+r.amount,0);
  const lastMonthRev = completedData.filter(r => r.date >= lastMonthStart && r.date <= lastMonthEnd).reduce((s,r)=>s+r.amount,0);

  const thisMonthJobs = completedData.filter(r => r.date >= thisMonthStart).length;
  const lastMonthJobs = completedData.filter(r => r.date >= lastMonthStart && r.date <= lastMonthEnd).length;

  let revChange = 0;
  if (lastMonthRev > 0) revChange = ((thisMonthRev - lastMonthRev) / lastMonthRev * 100);
  let jobChange = 0;
  if (lastMonthJobs > 0) jobChange = ((thisMonthJobs - lastMonthJobs) / lastMonthJobs * 100);

  const revUp = revChange >= 0;
  const jobUp = jobChange >= 0;

  const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];

  container.innerHTML = `
    <div style="display:flex; gap:30px; flex-wrap:wrap;">
      <div style="flex:1; min-width:180px;">
        <div style="color:var(--text-muted); font-size:0.8rem; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Revenue</div>
        <div class="growth-indicator">
          <span class="growth-arrow ${revUp ? 'up' : 'down'}">${revUp ? '▲' : '▼'}</span>
          <span class="growth-pct ${revUp ? 'up' : 'down'}">${Math.abs(revChange).toFixed(1)}%</span>
        </div>
        <div class="growth-detail" style="margin-top:10px;">
          ${months[now.getMonth()]}: ${fmt(thisMonthRev)}<br>
          ${months[now.getMonth() === 0 ? 11 : now.getMonth()-1]}: ${fmt(lastMonthRev)}
        </div>
      </div>
      <div style="flex:1; min-width:180px;">
        <div style="color:var(--text-muted); font-size:0.8rem; text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Jobs</div>
        <div class="growth-indicator">
          <span class="growth-arrow ${jobUp ? 'up' : 'down'}">${jobUp ? '▲' : '▼'}</span>
          <span class="growth-pct ${jobUp ? 'up' : 'down'}">${Math.abs(jobChange).toFixed(1)}%</span>
        </div>
        <div class="growth-detail" style="margin-top:10px;">
          ${months[now.getMonth()]}: ${thisMonthJobs} jobs<br>
          ${months[now.getMonth() === 0 ? 11 : now.getMonth()-1]}: ${lastMonthJobs} jobs
        </div>
      </div>
    </div>
  `;
}

// --- Avg Ticket Trend ---
function renderAvgTicketTrend() {
  const container = document.getElementById('avgTicketTrend');
  container.innerHTML = '';
  if (filteredData.length === 0) { container.innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:40px 0;">No data</p>'; return; }

  const buckets = {};
  const counts = {};
  filteredData.forEach(r => {
    const key = r.date.getFullYear() + '-' + String(r.date.getMonth()+1).padStart(2,'0');
    buckets[key] = (buckets[key] || 0) + r.amount;
    counts[key] = (counts[key] || 0) + 1;
  });

  const sortedKeys = Object.keys(buckets).sort();
  const avgs = sortedKeys.map(k => buckets[k] / counts[k]);
  const maxVal = Math.max(...avgs, 1);

  sortedKeys.forEach((key, i) => {
    const avg = avgs[i];
    const pct = (avg / maxVal * 100);
    const isTop = avg === maxVal;
    const group = document.createElement('div');
    group.className = 'vbar-group';
    group.innerHTML = `
      <div class="vbar-amount">${fmt(Math.round(avg))}</div>
      <div class="vbar${isTop ? ' top-performer' : ''}" style="height:${Math.max(pct, 2)}%"></div>
      <div class="vbar-label">${formatMonthLabel(key)}</div>
    `;
    container.appendChild(group);
  });
}

// --- Goal Tracker ---
function updateGoal() {
  const goalInput = document.getElementById('goalInput');
  const goal = parseFloat(goalInput.value) || 0;

  const now = new Date();
  const thisMonthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const thisMonthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0);
  const daysInMonth = thisMonthEnd.getDate();
  const daysRemaining = daysInMonth - now.getDate();

  const completedData = allData.filter(r => r.status !== 'cancelled' && r.status !== 'canceled');
  const thisMonthRev = completedData.filter(r => r.date >= thisMonthStart).reduce((s,r)=>s+r.amount,0);

  let pct = goal > 0 ? Math.min(thisMonthRev / goal * 100, 100) : 0;

  document.getElementById('goalFill').style.width = pct + '%';
  document.getElementById('goalPctText').textContent = pct.toFixed(1) + '%';
  document.getElementById('goalCurrentText').textContent = fmt(thisMonthRev) + ' earned this month';
  document.getElementById('goalRemainingText').textContent = goal > 0
    ? fmt(Math.max(goal - thisMonthRev, 0)) + ' remaining | ' + daysRemaining + ' days left'
    : daysRemaining + ' days left in ' + ['January','February','March','April','May','June','July','August','September','October','November','December'][now.getMonth()];

  // Save goal to localStorage
  if (goal > 0) localStorage.setItem('rcGoal', goal);
}

// Restore goal
(function() {
  const saved = localStorage.getItem('rcGoal');
  if (saved) document.getElementById('goalInput').value = saved;
})();

// ================= COPY SUMMARY =================
function copySummary() {
  if (filteredData.length === 0) { showToast('No data to summarize'); return; }

  const totalRevenue = filteredData.reduce((s, r) => s + r.amount, 0);
  const totalJobs = filteredData.length;
  const avgTicket = totalJobs > 0 ? totalRevenue / totalJobs : 0;
  const totalTips = filteredData.reduce((s, r) => s + r.tips, 0);
  const totalCommission = filteredData.reduce((s, r) => s + r.commission, 0);
  const newC = filteredData.filter(r => r.customerType.toLowerCase().includes('new')).length;
  const retC = totalJobs - newC;

  const emps = {};
  filteredData.forEach(r => {
    if (!emps[r.employee]) emps[r.employee] = { jobs: 0, rev: 0 };
    emps[r.employee].jobs++;
    emps[r.employee].rev += r.amount;
  });
  const empLines = Object.entries(emps)
    .sort((a,b) => b[1].rev - a[1].rev)
    .map(([n, d]) => `  ${n}: ${d.jobs} jobs, ${fmt(d.rev)}`)
    .join('\n');

  const rangeName = document.querySelector('.date-btn.active').textContent;

  const text = `RC DETAILING - Performance Summary
Period: ${rangeName}
${'='.repeat(35)}
Total Revenue: ${fmt(totalRevenue)}
Jobs Completed: ${totalJobs}
Average Ticket: ${fmt(Math.round(avgTicket))}
Total Tips: ${fmt(totalTips)}
Total Commission: ${fmt(totalCommission)}
New Customers: ${newC} | Returning: ${retC}

By Employee:
${empLines}
${'='.repeat(35)}
Generated: ${new Date().toLocaleString()}`;

  // iOS-compatible copy
  copyToClipboardFallback(text);
}

function copyToClipboardFallback(text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(() => showToast('Summary copied!')).catch(() => fallbackCopy(text));
  } else {
    fallbackCopy(text);
  }
}

function fallbackCopy(text) {
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.left = '-9999px';
  ta.style.top = '0';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.focus();
  ta.select();
  try {
    const range = document.createRange();
    range.selectNodeContents(ta);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
    ta.setSelectionRange(0, ta.value.length);
    document.execCommand('copy');
    showToast('Summary copied!');
  } catch (e) {
    showToast('Copy failed - try selecting manually');
  }
  document.body.removeChild(ta);
}

// ================= DEMO DATA =================
function loadDemoData() {
  const employees = ['Chase', 'Mike', 'Jordan', 'Tyler'];
  const services = [
    { name: 'Express Wash', min: 35, max: 55 },
    { name: 'Interior Detail', min: 100, max: 175 },
    { name: 'Exterior Detail', min: 100, max: 175 },
    { name: 'Full Detail', min: 200, max: 350 },
    { name: 'Paint Correction', min: 300, max: 600 },
    { name: 'Ceramic Coating', min: 500, max: 1200 },
    { name: 'PPF Installation', min: 800, max: 2500 },
    { name: 'Window Tint', min: 150, max: 350 }
  ];
  const vehicles = ['Sedan', 'SUV', 'Truck', 'Coupe', 'Van', 'Sports Car', 'Hatchback', 'Luxury Sedan', 'Crossover'];
  const payments = ['Card', 'Cash', 'Venmo', 'Zelle', 'Check'];
  const firstNames = ['John','Jane','Bob','Alice','Michael','Sarah','David','Emily','Chris','Amanda','James','Lisa','Robert','Maria','Kevin','Jennifer','Tom','Ashley','Andrew','Megan','Brian','Katie','Steve','Rachel','Dan','Nicole','Matt','Lauren','Eric','Samantha','Jeff','Heather'];
  const lastNames = ['Smith','Johnson','Williams','Brown','Jones','Davis','Miller','Wilson','Moore','Taylor','Anderson','Thomas','Jackson','White','Harris','Martin','Garcia','Thompson','Martinez','Robinson','Clark','Rodriguez','Lewis','Lee','Walker','Hall','Allen','Young','King','Wright'];
  const customerNames = [];
  for (let i = 0; i < 40; i++) {
    customerNames.push(firstNames[Math.floor(Math.random()*firstNames.length)] + ' ' + lastNames[Math.floor(Math.random()*lastNames.length)]);
  }

  const data = [];
  const now = new Date();
  const startDate = new Date(now);
  startDate.setDate(startDate.getDate() - 90);

  const returningCustomers = new Set();
  const numRows = 65 + Math.floor(Math.random() * 25); // 65-90 rows

  for (let i = 0; i < numRows; i++) {
    const daysOffset = Math.floor(Math.random() * 90);
    const d = new Date(startDate);
    d.setDate(d.getDate() + daysOffset);

    // Skip some Sundays (detailers usually off)
    if (d.getDay() === 0 && Math.random() > 0.15) {
      i--;
      continue;
    }

    const svc = services[Math.floor(Math.random() * services.length)];
    // Weight towards more common services
    let selectedSvc = svc;
    if (Math.random() < 0.35) selectedSvc = services[Math.floor(Math.random() * 4)]; // bias toward first 4

    const amount = Math.round(selectedSvc.min + Math.random() * (selectedSvc.max - selectedSvc.min));
    const emp = employees[Math.floor(Math.random() * employees.length)];

    // Chase does slightly more jobs
    let selectedEmp = emp;
    if (Math.random() < 0.15) selectedEmp = 'Chase';

    const tip = Math.random() < 0.7 ? Math.round(Math.random() * 50 / 5) * 5 : 0;
    const commission = Math.round(amount * 0.2);

    // Hours based on service
    let hours;
    if (selectedSvc.name === 'Express Wash') hours = 0.5 + Math.random() * 0.5;
    else if (selectedSvc.name.includes('Detail')) hours = 2 + Math.random() * 2;
    else if (selectedSvc.name === 'Ceramic Coating') hours = 4 + Math.random() * 4;
    else if (selectedSvc.name === 'PPF Installation') hours = 5 + Math.random() * 5;
    else if (selectedSvc.name === 'Paint Correction') hours = 3 + Math.random() * 3;
    else if (selectedSvc.name === 'Window Tint') hours = 1.5 + Math.random() * 2;
    else hours = 2 + Math.random() * 2;
    hours = Math.round(hours * 10) / 10;

    const customer = customerNames[Math.floor(Math.random() * customerNames.length)];
    let custType;
    if (returningCustomers.has(customer)) {
      custType = 'Returning';
    } else {
      custType = 'New';
      returningCustomers.add(customer);
    }

    const status = Math.random() < 0.95 ? 'Completed' : 'Cancelled';
    if (status === 'Cancelled') continue; // skip cancelled for cleaner demo

    data.push({
      date: d,
      customer: customer,
      service: selectedSvc.name,
      amount: amount,
      employee: selectedEmp,
      tips: tip,
      commission: commission,
      hours: hours,
      status: 'completed',
      payment: payments[Math.floor(Math.random() * payments.length)],
      vehicle: vehicles[Math.floor(Math.random() * vehicles.length)],
      customerType: custType
    });
  }

  data.sort((a, b) => a.date - b.date);
  allData = data;
  document.getElementById('lastUpdated').textContent = 'Demo data loaded: ' + new Date().toLocaleString() + ' (' + data.length + ' rows)';
  showToast('Demo data loaded: ' + data.length + ' records');
  applyFilter();
}

function clearData() {
  allData = [];
  filteredData = [];
  document.getElementById('dashboard').classList.remove('active');
